<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.project.ControllerDesktop">
   <children>
      <Label text="Formulari d'Usuari" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
      <HBox spacing="10.0" alignment="CENTER">
         <children>
            <Label text="Nom:" />
            <TextField fx:id="txtNom" promptText="Introdueix el nom" />
         </children>
      </HBox>
      <HBox spacing="10.0" alignment="CENTER">
         <children>
            <Label text="Edat:" />
            <TextField fx:id="txtEdat" promptText="Introdueix l'edat" />
         </children>
      </HBox>
      <Button text="Enviar a Vista Mobile" onAction="#enviarDades" />
      <Label fx:id="lblError" textFill="RED" />
   </children>
   <padding>
      <Insets top="20" right="20" bottom="20" left="20"/>
   </padding>
</VBox>
